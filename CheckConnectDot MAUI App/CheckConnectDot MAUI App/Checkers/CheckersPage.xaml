<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheckConnectDot_MAUI_App.CheckersPage"
             Title="Checkers">
    <Grid RowDefinitions="*, auto" ColumnDefinitions="*" Margin="15">
        <Label Grid.Column="0" Grid.Row="0"
            Text="Welcome to Checkers!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        
        <Grid Grid.Column="0" Grid.Row="1"
            x:Name="_gridBoard" ColumnDefinitions="*, *, *, *, *, *, *, *, *" RowDefinitions="*, *, *, *, *, *, *, *"
              
              ColumnSpacing="0"
              RowSpacing="0"
              HorizontalOptions="Center"
              
              ></Grid>

        <Label x:Name="_txtGameInfo" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="Center"></Label>
        
    </Grid>
</ContentPage>